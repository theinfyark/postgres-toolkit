{
  "name": "postgres-toolkit",
  "version": "1.1.0",
  "description": "PostgreSQL helper with connection pool, retry, transactions, health checks, query logging, and connection stats.",
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "require": "./dist/index.cjs",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "types",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "test": "node --test tests/db.test.js",
    "prepublishOnly": "npm test && npm run build",
    "build": "tsup src/index.js --format cjs --clean --sourcemap"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "pg",
    "pool",
    "transaction",
    "retry",
    "database",
    "sql",
    "node-postgres",
    "connection-pool",
    "health-check",
    "postgres-client",
    "database-tools",
    "nodejs",
    "typescript",
    "pooling"
  ],
  "author": "anilachary",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theinfyark/postgres-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/theinfyark/postgres-toolkit/issues"
  },
  "homepage": "https://github.com/theinfyark/postgres-toolkit#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "pg": "^8.16.0"
  },
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/anilachary"
  },
  "module": "./src/index.js",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.6.3"
  }
}
